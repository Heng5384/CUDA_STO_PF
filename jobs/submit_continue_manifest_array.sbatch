#!/usr/bin/env bash
# Array job template: run one dynamics-continue case from a manifest CSV row.
#
# Required env:
#   MANIFEST_CSV   absolute path to a CSV generated by tools/analysis/submit_dynamics_continue_batch.py
# Optional env:
#   MANIFEST_NAME  a short label used for logs and temporary PF param files
#   MODE           defaults to dynamics-continue

#SBATCH --job-name=continue_dyn_array
#SBATCH --partition=gpu_uvip
#SBATCH --qos=gpu_uvip
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --mem=0
#SBATCH --output=/dev/null
#SBATCH --error=/dev/null

set -euo pipefail

if [[ -z "${MANIFEST_CSV:-}" ]]; then
  echo "[fatal] MANIFEST_CSV is required." >&2
  exit 2
fi

if [[ -z "${SLURM_ARRAY_TASK_ID:-}" ]]; then
  echo "[fatal] SLURM_ARRAY_TASK_ID is required." >&2
  exit 2
fi

if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/jobs/_site_env.sh" ]]; then
  SCRIPT_DIR="${SLURM_SUBMIT_DIR}/jobs"
elif [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/_site_env.sh" ]]; then
  SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
source "${SCRIPT_DIR}/_site_env.sh"
site_setup_project_root "${SCRIPT_DIR}"
cd "${PROJECT_ROOT}"

MANIFEST_NAME=${MANIFEST_NAME:-continue_dyn_batch}
MODE=${MODE:-dynamics-continue}

site_redirect_slurm_logs "${MANIFEST_NAME}_${SLURM_ARRAY_TASK_ID}"
site_print_env_banner
site_build_main_cuda

row_exports="$(
python3 - "${MANIFEST_CSV}" "${SLURM_ARRAY_TASK_ID}" <<'PY'
import csv
import sys
from pathlib import Path

manifest = Path(sys.argv[1]).expanduser().resolve()
idx = int(sys.argv[2])
with manifest.open(newline="", encoding="utf-8") as f:
    rows = list(csv.DictReader(f))
if idx < 0 or idx >= len(rows):
    raise SystemExit(f"array index {idx} out of range 0..{len(rows)-1}")
row = rows[idx]
for key, value in row.items():
    if value is None or value == "":
        continue
    if key.upper() == "SLURM_EXPORT_ENV":
        continue
    print(f"export {key}={value!r}")
PY
)"

eval "${row_exports}"

PF_PARAM_FILE="$(site_generate_pf_param_file "${MANIFEST_NAME}_${SLURM_ARRAY_TASK_ID}")"
echo "[info] PF_PARAM_FILE=${PF_PARAM_FILE}"

CMD=(
  ./main_cuda "${NX}" "${NY}" "${NZ}" "${DT}" "${NSTEPS}" "${OUT_EVERY}" "${CSV_OUT_EVERY}" "${ELASTIC}"
  --pf-param-file "${PF_PARAM_FILE}"
  --mode="${MODE}"
  --minimize-max-iter "${NSTEPS}"
  --minimize-dt "${MIN_DT}"
  --minimize-full-model
  --radius-phys-nm "${RADIUS}"
  --elastic "${ELASTIC}"
  --ic-23d-xB-out "${XB_OUT}"
  --continue-phi-vtk "${CONTINUE_PHI_VTK}"
  --continue-xB-vtk "${CONTINUE_XB_VTK}"
  --minimize-rms-dphi-threshold "${MIN_RMS_DPHI_THRESHOLD:-1e-5}"
  --minimize-rms-dY-threshold "${MIN_RMS_DY_THRESHOLD:-1e-5}"
  --minimize-energy-diff-rel-threshold "${MIN_ENERGY_DIFF_REL_THRESHOLD:-1e-7}"
  --minimize-rms-res-for-energy-plateau "${MIN_RMS_RES_FOR_ENERGY_PLATEAU:-1e-5}"
  --minimize-convergence-steps "${MIN_CONVERGENCE_STEPS:-100}"
  --minimize-dt-safety-limit "${MIN_DT_SAFETY_LIMIT:-1e-6}"
  --minimize-rms-res-threshold "${MIN_RMS_RES_THRESHOLD:-1e-4}"
  --minimize-vol-err-rel-threshold "${MIN_VOL_ERR_REL_THRESHOLD:-3e-2}"
  --eta-lambda-vol "${ETA_LAMBDA_VOL:-0.9}"
  --minimize-post-projection-iters "${POST_PROJ_ITERS:-1}"
)

set -x
"${CMD[@]}"
set +x
