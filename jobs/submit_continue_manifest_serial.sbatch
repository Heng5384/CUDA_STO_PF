#!/usr/bin/env bash
# Serial job template: run all dynamics-continue cases listed in a manifest CSV sequentially.
#
# Required env:
#   MANIFEST_CSV   absolute path to a CSV generated by tools/analysis/submit_dynamics_continue_batch.py
# Optional env:
#   MANIFEST_NAME  a short label used for logs and temporary PF param files
#   MODE           defaults to dynamics-continue

#SBATCH --job-name=continue_dyn_serial
#SBATCH --partition=gpu_uvip
#SBATCH --qos=gpu_uvip
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --mem=0
#SBATCH --output=/dev/null
#SBATCH --error=/dev/null

set -euo pipefail

if [[ -z "${MANIFEST_CSV:-}" ]]; then
  echo "[fatal] MANIFEST_CSV is required." >&2
  exit 2
fi

if [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/jobs/_site_env.sh" ]]; then
  SCRIPT_DIR="${SLURM_SUBMIT_DIR}/jobs"
elif [[ -n "${SLURM_SUBMIT_DIR:-}" && -f "${SLURM_SUBMIT_DIR}/_site_env.sh" ]]; then
  SCRIPT_DIR="${SLURM_SUBMIT_DIR}"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
source "${SCRIPT_DIR}/_site_env.sh"
site_setup_project_root "${SCRIPT_DIR}"
cd "${PROJECT_ROOT}"

MANIFEST_NAME=${MANIFEST_NAME:-continue_dyn_serial}
MODE=${MODE:-dynamics-continue}

site_redirect_slurm_logs "${MANIFEST_NAME}"
site_print_env_banner
site_build_main_cuda

manifest_rows="$(
python3 - "${MANIFEST_CSV}" <<'PY'
import csv
import sys
from pathlib import Path

manifest = Path(sys.argv[1]).expanduser().resolve()
with manifest.open(newline="", encoding="utf-8") as f:
    rows = list(csv.DictReader(f))

for idx, row in enumerate(rows):
    print(f"__ROW_BEGIN__ {idx}")
    for key, value in row.items():
        if value is None or value == "":
            continue
        if key.upper() == "SLURM_EXPORT_ENV":
            continue
        print(f"{key}={value}")
    print("__ROW_END__")
PY
)"

generate_continue_pf_param_file() {
  local row_idx="$1"
  local source_summary_path="${CONTINUE_SOURCE_SUMMARY_PATH:-${SUMMARY_PATH:-}}"
  local source_dir
  local source_pf
  local safe_tag
  local out_pf

  if [[ -z "${source_summary_path}" ]]; then
    echo "[fatal] CONTINUE_SOURCE_SUMMARY_PATH or SUMMARY_PATH is required for continue runs." >&2
    return 2
  fi
  source_dir="$(dirname "${source_summary_path}")"
  source_pf="${source_dir}/pf_input.params"
  if [[ ! -f "${source_pf}" ]]; then
    echo "[fatal] source continue pf_input.params not found: ${source_pf}" >&2
    return 2
  fi

  safe_tag="$(site_make_safe_tag "${MANIFEST_NAME}_${row_idx}")"
  out_pf="${PROJECT_ROOT}/jobs/generated/pf_params_${safe_tag}.params"
  python3 - "${source_pf}" "${out_pf}" "${DT}" <<'PY'
import sys
from pathlib import Path

source_pf = Path(sys.argv[1])
out_pf = Path(sys.argv[2])
dt_value = float(sys.argv[3])

lines = source_pf.read_text(encoding="utf-8").splitlines()
updated = []
replaced = False
for line in lines:
    if line.startswith("dt="):
        updated.append(f"dt={dt_value:.16e}")
        replaced = True
    else:
        updated.append(line)
if not replaced:
    updated.append(f"dt={dt_value:.16e}")
out_pf.write_text("\n".join(updated) + "\n", encoding="utf-8")
PY
  echo "[site-env] continue_source_pf=${source_pf}" >&2
  echo "[site-env] continue_dt_override=${DT}" >&2
  echo "[site-env] pf_param_file=${out_pf}" >&2
  printf '%s\n' "${out_pf}"
}

run_case() {
  local row_idx="$1"
  local exports_block="$2"
  eval "${exports_block}"
  PF_PARAM_FILE="$(generate_continue_pf_param_file "${row_idx}")"
  echo "[info] PF_PARAM_FILE=${PF_PARAM_FILE}"
  CMD=(
    ./main_cuda "${NX}" "${NY}" "${NZ}" "${DT}" "${NSTEPS}" "${OUT_EVERY}" "${CSV_OUT_EVERY}" "${ELASTIC}"
    --pf-param-file "${PF_PARAM_FILE}"
    --mode="${MODE}"
    --minimize-max-iter "${NSTEPS}"
    --minimize-dt "${MIN_DT}"
    --minimize-full-model
    --radius-phys-nm "${RADIUS}"
    --elastic "${ELASTIC}"
    --ic-23d-xB-out "${XB_OUT}"
    --continue-phi-vtk "${CONTINUE_PHI_VTK}"
    --continue-xB-vtk "${CONTINUE_XB_VTK}"
    --minimize-rms-dphi-threshold "${MIN_RMS_DPHI_THRESHOLD:-1e-5}"
    --minimize-rms-dY-threshold "${MIN_RMS_DY_THRESHOLD:-1e-5}"
    --minimize-energy-diff-rel-threshold "${MIN_ENERGY_DIFF_REL_THRESHOLD:-1e-7}"
    --minimize-rms-res-for-energy-plateau "${MIN_RMS_RES_FOR_ENERGY_PLATEAU:-1e-5}"
    --minimize-convergence-steps "${MIN_CONVERGENCE_STEPS:-100}"
    --minimize-dt-safety-limit "${MIN_DT_SAFETY_LIMIT:-1e-6}"
    --minimize-rms-res-threshold "${MIN_RMS_RES_THRESHOLD:-1e-4}"
    --minimize-vol-err-rel-threshold "${MIN_VOL_ERR_REL_THRESHOLD:-3e-2}"
    --eta-lambda-vol "${ETA_LAMBDA_VOL:-0.9}"
    --minimize-post-projection-iters "${POST_PROJ_ITERS:-1}"
  )
  set -x
  "${CMD[@]}"
  set +x
}

current_idx=""
current_block=""
while IFS= read -r line; do
  if [[ "${line}" == __ROW_BEGIN__* ]]; then
    current_idx="${line#* }"
    current_block=""
  elif [[ "${line}" == __ROW_END__ ]]; then
    echo "[info] starting row ${current_idx}"
    run_case "${current_idx}" "${current_block}"
    current_block=""
    current_idx=""
  else
    if [[ -n "${current_block}" ]]; then
      current_block+=$'\n'
    fi
    current_block+="export ${line}"
  fi
done <<< "${manifest_rows}"
